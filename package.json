{
  "name": "Marszy's blog",
  "author": "Marszy",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "node ./scripts/gen-rss.mjs && next build && next-sitemap --config ./scripts/next-sitemap.config.js",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:posts": "node ./scripts/validate-posts.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm validate:posts",
    "prepare": "husky"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "autoprefixer": "^10.4.23",
    "gray-matter": "^4.0.3",
    "next": "14.2.35",
    "next-sitemap": "^4.2.3",
    "nextra": "2.13.4",
    "nextra-theme-blog": "2.13.4",
    "postcss": "^8.5.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.7.0",
    "rss": "^1.2.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@next/env": "14.2.35",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "marked": "^18.0.5",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,css,md,mdx}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.9.0"
}
