{
  "name": "Marszy's blog",
  "author": "Marszy",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check && node ./scripts/gen-rss.mjs && next build --turbopack && next-sitemap --config ./scripts/next-sitemap.config.js",
    "start": "next start",
    "lint": "eslint app components lib scripts mdx-components.tsx",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:posts": "node ./scripts/validate-posts.mjs",
    "test:dates": "node --test scripts/content-date.test.mjs",
    "test:tags": "node --test scripts/tag-index.test.mjs",
    "test:frontmatter": "node --test scripts/frontmatter.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm validate:posts && pnpm test:dates && pnpm test:tags && pnpm test:frontmatter",
    "prepare": "husky"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "next": "16.4.6",
    "next-sitemap": "^4.2.3",
    "nextra": "4.6.1",
    "nextra-theme-blog": "4.6.1",
    "postcss": "^8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "rss": "^1.2.2",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "marked": "^18.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "@tailwindcss/postcss": "4.3.5",
    "@eslint/js": "^10.0.1"
  },
  "packageManager": "pnpm@12.18.0"
}
