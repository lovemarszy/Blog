{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm"],
  "timezone": "Asia/Shanghai",
  "schedule": ["before 8am on Sunday"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "matchPackageNames": ["nextra", "nextra-theme-blog"],
      "allowedVersions": ">=4.0.0 <5.0.0"
    },
    {
      "matchPackageNames": ["tailwindcss", "@tailwindcss/postcss"],
      "allowedVersions": ">=4.0.0 <5.0.0"
    },
    {
      "matchPackageNames": ["next", "@next/env"],
      "allowedVersions": ">=16.0.0 <17.0.0"
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "allowedVersions": ">=19.0.0 <20.0.0"
    },
    {
      "matchPackageNames": ["eslint", "@eslint/js"],
      "allowedVersions": ">=10.0.0 <11.0.0"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    },
    {
      "matchPackageNames": ["yaml"],
      "allowedVersions": ">=2.9.1 <3.0.0"
    },
    {
      "matchPackageNames": ["eslint-config-next"],
      "allowedVersions": ">=16.0.0 <17.0.0"
    },
    {
      "matchDepTypes": ["pnpm-workspace.overrides"],
      "rangeStrategy": "in-range-only"
    }
  ],
  "rangeStrategy": "bump",
  "postUpdateOptions": ["pnpmDedupe"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0
}
